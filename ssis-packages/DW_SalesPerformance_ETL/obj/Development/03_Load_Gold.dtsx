                  description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Commande SQL à exécuter."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    cp.ProductID,
    CAST(cp.ProductName    AS VARCHAR(100)) AS ProductName,
    CAST(cp.ProductNumber  AS VARCHAR(25))  AS ProductNumber,
    CAST(cp.CategoryName   AS VARCHAR(50))  AS CategoryName,
    CAST(cp.SubcategoryName AS VARCHAR(50)) AS SubcategoryName,
    CAST(cp.Color          AS VARCHAR(20))  AS Color,
    CAST(cch.StandardCost  AS DECIMAL(18,2)) AS StandardCost,
    CAST(ISNULL(cph.ListPrice, cp.ListPrice) AS DECIMAL(18,2)) AS ListPrice,
    CAST(cp.Weight         AS DECIMAL(8,2))  AS Weight,
    CAST(cch.StartDate     AS DATE)          AS StartDate,
    CAST(cch.EndDate       AS DATE)          AS EndDate,
    CAST(cch.IsCurrent     AS BIT)           AS IsCurrent
FROM silver.CleanProduct cp
JOIN silver.CleanProductCostHistory cch
    ON cp.ProductID = cch.ProductID
LEFT JOIN silver.CleanProductPriceHistory cph
    ON  cp.ProductID  = cph.ProductID
    AND cch.StartDate = cph.StartDate</property>
