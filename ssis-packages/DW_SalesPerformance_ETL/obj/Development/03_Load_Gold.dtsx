        <SQLTask:SqlTaskData
          SQLTask:Connection="{7C53B75C-A499-4F60-816F-AE81C0A05AD2}"
          SQLTask:SqlStatementSource="-- Supprimer les FK&#xA;ALTER TABLE gold.FactSales DROP CONSTRAINT FK_FactSales_DimDate;&#xA;ALTER TABLE gold.FactSales DROP CONSTRAINT FK_FactSales_DimProduct;&#xA;ALTER TABLE gold.FactSales DROP CONSTRAINT FK_FactSales_DimCustomer;&#xA;ALTER TABLE gold.FactSales DROP CONSTRAINT FK_FactSales_DimTerritory;&#xA;ALTER TABLE gold.FactSales DROP CONSTRAINT FK_FactSales_DimSalesPerson;&#xA;&#xA;-- Tronquer&#xA;TRUNCATE TABLE gold.FactSales;&#xA;TRUNCATE TABLE gold.DimDate;&#xA;TRUNCATE TABLE gold.DimProduct;&#xA;TRUNCATE TABLE gold.DimCustomer;&#xA;TRUNCATE TABLE gold.DimTerritory;&#xA;TRUNCATE TABLE gold.DimSalesPerson;&#xA;&#xA;-- Recréer les FK&#xA;ALTER TABLE gold.FactSales ADD&#xA;    CONSTRAINT FK_FactSales_DimDate&#xA;        FOREIGN KEY (DateKey) REFERENCES gold.DimDate(DateKey),&#xA;    CONSTRAINT FK_FactSales_DimProduct&#xA;        FOREIGN KEY (ProductKey) REFERENCES gold.DimProduct(ProductKey),&#xA;    CONSTRAINT FK_FactSales_DimCustomer&#xA;        FOREIGN KEY (CustomerKey) REFERENCES gold.DimCustomer(CustomerKey),&#xA;    CONSTRAINT FK_FactSales_DimTerritory&#xA;        FOREIGN KEY (TerritoryKey) REFERENCES gold.DimTerritory(TerritoryKey),&#xA;    CONSTRAINT FK_FactSales_DimSalesPerson&#xA;        FOREIGN KEY (SalesPersonKey) REFERENCES gold.DimSalesPerson(SalesPersonKey);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
