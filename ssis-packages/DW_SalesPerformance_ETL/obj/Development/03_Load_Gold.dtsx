                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT ProductKey, ProductID
FROM gold.DimProduct
WHERE IsCurrent = 1

UNION ALL

SELECT MAX(ProductKey), ProductID
FROM gold.DimProduct
WHERE IsCurrent = 0
AND ProductID NOT IN (SELECT ProductID FROM gold.DimProduct WHERE IsCurrent = 1)
GROUP BY ProductID</property>
