                      name="Expression">#{Package\DF - CleanSales\Source OLE DB.Outputs[Sortie de source OLE DB].Columns[Status]} == 5 &amp;&amp; #{Package\DF - CleanSales\Source OLE DB.Outputs[Sortie de source OLE DB].Columns[UnitPrice]} &gt; 0 &amp;&amp; #{Package\DF - CleanSales\Source OLE DB.Outputs[Sortie de source OLE DB].Columns[StandardCost]} &gt; 0</property>
