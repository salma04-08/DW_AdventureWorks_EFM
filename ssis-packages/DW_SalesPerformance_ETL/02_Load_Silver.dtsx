          SQLTask:SqlStatementSource="IF OBJECT_ID('silver.CleanSales')               IS NOT NULL TRUNCATE TABLE silver.CleanSales;&#xA;IF OBJECT_ID('silver.CleanProduct')             IS NOT NULL TRUNCATE TABLE silver.CleanProduct;&#xA;IF OBJECT_ID('silver.CleanCustomer')            IS NOT NULL TRUNCATE TABLE silver.CleanCustomer;&#xA;IF OBJECT_ID('silver.CleanTerritory')           IS NOT NULL TRUNCATE TABLE silver.CleanTerritory;&#xA;IF OBJECT_ID('silver.CleanSalesPerson')         IS NOT NULL TRUNCATE TABLE silver.CleanSalesPerson;&#xA;IF OBJECT_ID('silver.CleanProductCostHistory')  IS NOT NULL TRUNCATE TABLE silver.CleanProductCostHistory;&#xA;IF OBJECT_ID('silver.CleanProductPriceHistory') IS NOT NULL TRUNCATE TABLE silver.CleanProductPriceHistory;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
