                  description="Commande SQL à exécuter."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    ProductID,
    CAST(StartDate AS DATE) AS StartDate,
    CASE
        WHEN EndDate IS NULL THEN NULL
        WHEN EndDate &gt; '2079-06-06' THEN CAST('2079-06-06' AS DATE)
        ELSE CAST(EndDate AS DATE)
    END AS EndDate,
    ListPrice,
    CASE WHEN EndDate IS NULL THEN 1 ELSE 0 END AS IsCurrent
FROM bronze.ProductListPriceHistory</property>
